      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(route_ping_index_lag_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "routed CPU",
      "description": "Cores used by the routed process.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 48
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
