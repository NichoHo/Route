{
  "uid": "route-overview",
  "title": "Route",
  "tags": [
    "route"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Orders per second",
      "description": "Orders accepted by POST /orders.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum(rate(route_orders_created_total[1m]))",
          "legendFormat": "created",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum(rate(route_matches_total[1m]))",
          "legendFormat": "offers sent",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Match latency",
      "description": "Order created to first offer sent. Histogram buckets stop at 30 s, so p99 above that reads as 30 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(route_match_latency_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(route_match_latency_seconds_bucket[1m])))",
          "legendFormat": "p99",
          "refId": "B"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Match rate",
      "description": "Orders assigned out of orders assigned or given up on.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum(rate(route_offer_outcome_total{outcome=\"accepted\"}[1m])) / (sum(rate(route_offer_outcome_total{outcome=\"accepted\"}[1m])) + sum(rate(route_orders_exhausted_total[1m])))",
          "legendFormat": "match rate",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Queue depth",
      "description": "Orders waiting for the matcher, and wake-ups dropped because its queue was full.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "route_queue_depth",
          "legendFormat": "queued orders",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum(rate(route_triggers_dropped_total[1m]))",
          "legendFormat": "wake-ups dropped per second",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Where a batch spends its time",
      "description": "Mean seconds per batch in each phase. Candidate search and offers are the cost; the solver is not.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum by (phase) (rate(route_batch_phase_seconds_sum[1m])) / sum by (phase) (rate(route_batch_phase_seconds_count[1m]))",
          "legendFormat": "{{phase}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Batch size",
      "description": "Mean orders per batch, and the batch rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum(rate(route_batch_size_sum[1m])) / sum(rate(route_batch_size_count[1m]))",
          "legendFormat": "mean orders per batch",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum(rate(route_batch_size_count[1m]))",
          "legendFormat": "batches per second",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Batched against greedy",
      "description": "Pickup distance of the batched solution over the greedy one, last batch. Below 1 means batching shortened pickups.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0.5,
          "max": 1.2
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "route_batched_vs_greedy_ratio",
          "legendFormat": "ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Offer outcomes",
      "description": "Offers per second by outcome.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum by (outcome) (rate(route_offer_outcome_total[1m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Orders sent back to the queue",
      "description": "Per second, by the reason the batch could not offer them.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum by (reason) (rate(route_order_requeues_total[1m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Claim conflicts",
      "description": "Courier claims lost to a concurrent batch, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum(rate(route_claim_conflicts_total[1m]))",
          "legendFormat": "conflicts",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Pings",
      "description": "Location pings dropped under load, out of order, or rejected, per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum(rate(route_pings_shed_total[1m]))",
          "legendFormat": "shed",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum(rate(route_out_of_order_pings_total[1m]))",
          "legendFormat": "out of order",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "route-prometheus"
          },
          "expr": "sum by (reason) (rate(route_pings_rejected_total[1m]))",
          "legendFormat": "rejected: {{reason}}",
          "refId": "C"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Ping index lag",
      "description": "A ping arriving to its position being written to Redis.",
      "datasource": {
        "type": "prometheus",
        "uid": "route-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
